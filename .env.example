# DevForge AI Configuration

# Application
PORT=3000
NODE_ENV=development

# Workspace Storage
DEVFORGE_STORAGE_DIR="./.devforge_data"
DEVFORGE_WORKSPACES_DIR="./temp_repos"

# AI Provider Configuration (Optional for initial setup, configured via UI or .env)
# Supported: gemini, openai, anthropic, ollama
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# GitHub Integration (Optional: for private repo access or PR creation)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Verification / Execution
AUTO_RUN_VERIFICATION=true
VERIFICATION_TIMEOUT_MS=60000
